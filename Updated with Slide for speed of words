import tkinter as tk
from tkinter import scrolledtext
import time
import threading
import re


class SpeedReaderApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Speed Reading Trainer")
        self.root.geometry("1080x1920")
        self.root.configure(bg="#f0f4f8")

        self.running = False
        self.chunk_size = 2  # You can make this user-controlled too

        # Text input area
        self.text_input = scrolledtext.ScrolledText(
            root, wrap=tk.WORD, width=60, height=8, font=("Arial", 12)
        )
        self.text_input.pack(pady=10)

        # Base speed slider
        self.speed_label = tk.Label(root, text="Base Speed (WPM):", bg="#f0f4f8")
        self.speed_label.pack()
        self.speed_slider = tk.Scale(
            root, from_=100, to=600, orient=tk.HORIZONTAL, length=400, resolution=10, bg="#f0f4f8"
        )
        self.speed_slider.set(250)
        self.speed_slider.pack()

        # Word display
        self.word_display = tk.Label(
            root, text="", font=("JoystixMonospace-Regular", 32), fg="#333", bg="#f0f4f8", wraplength=1000
        )
        self.word_display.pack(pady=50)

        # Start button
        self.start_button = tk.Button(
            root,
            text="Start Reading",
            command=self.start_reading,
            font=("Arial", 14),
            bg="#4CAF50",
            fg="white",
            padx=10,
            pady=5,
        )
        self.start_button.pack()

    def start_reading(self):
        text = self.text_input.get("1.0", tk.END).strip()
        if not text:
            self.word_display.config(text="Please enter some text.")
            return

        words = text.split()
        self.word_chunks = [  # Create word chunks
            " ".join(words[i:i + self.chunk_size])
            for i in range(0, len(words), self.chunk_size)
        ]

        self.running = True
        threading.Thread(target=self.run_speed_curve_reading).start()

    def run_speed_curve_reading(self):
        total_rounds = 5
        base_wpm = self.speed_slider.get()

        for round_num in range(total_rounds):
            if not self.running:
                break

            # Speed curve: slow → fast → medium
            if round_num <= total_rounds // 2:
                # Speeding up
                speed_multiplier = 1 + (round_num / total_rounds)
            else:
                # Slowing slightly
                speed_multiplier = 1.5 - (round_num / (2 * total_rounds))

            self.display_message(f"Round {round_num + 1}", 1.5)

            for chunk in self.word_chunks:
                if not self.running:
                    break

                adjusted_wpm = base_wpm * speed_multiplier
                delay_sec = self.calculate_delay(chunk, adjusted_wpm)

                self.word_display.config(text=chunk)
                time.sleep(delay_sec)

        self.word_display.config(text="Done!")

    def calculate_delay(self, chunk, wpm):
        words_in_chunk = len(chunk.split())
        base_delay = 60 / wpm * words_in_chunk

        # Add delay based on punctuation
        if re.search(r'[.,;:!?]$', chunk.strip()):
            base_delay *= 1.5  # extra pause for punctuation

        return base_delay

    def display_message(self, message, duration_sec):
        self.word_display.config(text=message)
        time.sleep(duration_sec)

    def stop(self):
        self.running = False


if __name__ == "__main__":
    root = tk.Tk()
    app = SpeedReaderApp(root)
    root.protocol("WM_DELETE_WINDOW", app.stop)
    root.mainloop()
